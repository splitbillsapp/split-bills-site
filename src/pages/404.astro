---
import Site from '../layouts/Site.astro';
import { dictionary, pageHref } from '../i18n';
import { defaultLocale, localeFromCode } from '../i18n/locales';

const locale = localeFromCode(defaultLocale);
const t = dictionary(locale.code);
---

<Site
  title={`${t.notFound.heading} ${t.site.name}`}
  description={t.notFound.body}
  page="home"
  noindex
>
  <section class="container lost">
    <div class="tile display" aria-hidden="true">404</div>
    <h1>{t.notFound.heading}</h1>
    <p>{t.notFound.body}</p>
    <div class="actions">
      <a class="button sticker-press" href={pageHref('home', locale)}>{t.notFound.home}</a>
      <a class="link" href={pageHref('privacy', locale)}>{t.footer.privacy}</a>
      <a class="link" href={pageHref('deleteAccount', locale)}>{t.footer.deleteAccount}</a>
    </div>
  </section>
</Site>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
    padding-block-start: var(--space-section);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    background: var(--color-disabled-fill);
    border: var(--keyline-base) dashed var(--color-disabled-outline);
    border-radius: var(--radius-xl);
    color: var(--color-disabled-text);
    font-size: 3.25rem;
    rotate: var(--tilt-left);
  }

  h1 {
    font-size: var(--text-h2);
  }

  p {
    max-width: 36ch;
    font-size: var(--text-lede);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-xl);
    background: var(--color-accent);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-family: var(--font-display);
    font-weight: 800;
    text-decoration: none;
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
