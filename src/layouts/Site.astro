---
import { Font } from 'astro:assets';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { currentLocale, dictionary, localesFor, pageHref, type PageId } from '../i18n';
import { ogSize } from '../og/render';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  page: PageId;
  /** For pages served at arbitrary URLs, like the 404: no canonical, not indexed. */
  noindex?: boolean;
}

const { title, description, page, noindex = false } = Astro.props;
const locale = currentLocale(Astro.currentLocale);
const t = dictionary(locale.code);
const site = Astro.site ?? new URL('https://splitbillsapp.com');

const alternates = localesFor(page);
const canonical = new URL(pageHref(page, locale), site);
const ogImage = new URL('/og.png', site);
---

<!doctype html>
<html lang={locale.code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f0d9" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        alternates.length > 1 &&
        alternates.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate.code}
            href={new URL(pageHref(page, alternate), site)}
          />
        ))
    }
    {
      !noindex && alternates.length > 1 && (
        <link rel="alternate" hreflang="x-default" href={new URL(pageHref(page, alternates[0]!), site)} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogSize.width)} />
    <meta property="og:image:height" content={String(ogSize.height)} />
    <meta property="og:image:alt" content={t.site.tagline} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ weight: '400' }]} />
  </head>
  <body>
    <a class="skip" href="#content">{t.nav.skipToContent}</a>
    <Header locale={locale} page={page} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} page={page} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 10;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-weight: 700;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
