---
import { dictionary, localesFor, pageHref, type PageId } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  current: Locale;
  page: PageId;
}

const { current, page } = Astro.props;
const t = dictionary(current.code);
const others = localesFor('home').filter((locale) => locale.code !== current.code);
---

{
  others.length > 0 && (
    <details class="switcher">
      <summary class="sticker-press">
        <span class="visually-hidden">{t.nav.language}: </span>
        <span lang={current.code}>{current.label}</span>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M3 6l5 5 5-5" />
        </svg>
      </summary>
      <ul class="menu">
        {others.map((locale) => (
          <li>
            <a href={pageHref(page, locale)} lang={locale.code} hreflang={locale.code}>
              {locale.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .switcher {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 0 var(--space-md);
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    list-style: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    fill: none;
    stroke: var(--color-outline);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--duration-press) ease-out;
  }

  .switcher[open] summary svg {
    rotate: 180deg;
  }

  .menu {
    position: absolute;
    top: calc(100% + var(--space-sm));
    right: 0;
    z-index: 5;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-sm);
    list-style: none;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu a:hover {
    background: var(--color-surface-muted);
  }
</style>
