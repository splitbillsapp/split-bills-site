---
import { dictionary, localesFor, pageHref, type PageId } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  current: Locale;
  page: PageId;
  /** `compact` is the header's initials sticker; `full` adds the language's name. */
  variant?: 'compact' | 'full';
  /** Which way the menu opens; the footer opens upward. */
  opens?: 'down' | 'up';
}

const { current, page, variant = 'compact', opens = 'down' } = Astro.props;
const t = dictionary(current.code);
const others = localesFor('home').filter((locale) => locale.code !== current.code);
---

{
  others.length > 0 && (
    <details class:list={['switcher', variant, `opens-${opens}`]}>
      <summary>
        <span class="visually-hidden">{t.nav.language}: </span>
        <span class="chip sticker-press" lang={current.code}>{current.short}</span>
        <span class:list={['name', { 'visually-hidden': variant === 'compact' }]} lang={current.code}>
          {current.label}
        </span>
        {
          variant === 'full' && (
            <svg class="chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              <path d="M3 6l5 5 5-5" />
            </svg>
          )
        }
      </summary>
      <ul class="menu">
        {others.map((locale) => (
          <li>
            <a href={pageHref(page, locale)} lang={locale.code} hreflang={locale.code}>
              <span class="chip small" aria-hidden="true">{locale.short}</span>
              {locale.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<script>
  // The details element has no light dismiss of its own; this closes an open
  // switcher on an outside click or Escape, and keeps only one open at a time.
  // Without JavaScript the control still opens and closes from its summary.
  const openSwitchers = () =>
    document.querySelectorAll<HTMLDetailsElement>('details.switcher[open]');

  document.addEventListener('click', (event) => {
    for (const details of openSwitchers()) {
      if (!details.contains(event.target as Node)) details.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const details of openSwitchers()) {
      details.open = false;
      details.querySelector('summary')?.focus();
    }
  });

  document.addEventListener(
    'toggle',
    (event) => {
      const opened = event.target as HTMLDetailsElement;
      if (!opened.matches('details.switcher') || !opened.open) return;
      for (const details of openSwitchers()) {
        if (details !== opened) details.open = false;
      }
    },
    true,
  );
</script>

<style>
  .switcher {
    position: relative;
    width: fit-content;
  }

  /* The sticker is 36px; the padding keeps the tap target at 44px. */
  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    min-width: 44px;
    min-height: 44px;
    padding: 4px;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 6px;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.02em;
    rotate: var(--tilt-left-slight);
  }

  .switcher[open] summary .chip {
    box-shadow: none;
    translate: var(--press-offset) var(--press-offset);
  }

  .chip.small {
    min-width: 30px;
    height: 30px;
    box-shadow: none;
    font-size: 0.8125rem;
    rotate: 0deg;
  }

  .name {
    font-weight: 700;
    white-space: nowrap;
  }

  .chevron {
    fill: none;
    stroke: var(--color-outline);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: rotate var(--duration-press) ease-out;
  }

  .switcher[open] .chevron {
    rotate: 180deg;
  }

  .full summary {
    padding-inline-end: var(--space-sm);
  }

  .menu {
    position: absolute;
    right: 0;
    z-index: 5;
    min-width: 13.5rem;
    max-height: 60vh;
    margin: 0;
    padding: var(--space-sm);
    overflow-y: auto;
    list-style: none;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .opens-down .menu {
    top: calc(100% + var(--space-xs));
  }

  .opens-up .menu {
    bottom: calc(100% + var(--space-xs));
    right: auto;
    left: 0;
  }

  .menu a {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 44px;
    padding: 0 var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu a:hover {
    background: var(--color-surface-muted);
  }
</style>
