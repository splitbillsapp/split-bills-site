---
import { dictionary, localesFor, pageHref, type PageId } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  current: Locale;
  page: PageId;
}

const { current, page } = Astro.props;
const t = dictionary(current.code);
const others = localesFor('home').filter((locale) => locale.code !== current.code);
---

{
  others.length > 0 && (
    <details class="switcher">
      <summary>
        <span class="visually-hidden">{t.nav.language}: </span>
        <span class="chip sticker-press" lang={current.code}>{current.short}</span>
        <span class="visually-hidden" lang={current.code}>{current.label}</span>
      </summary>
      <ul class="menu">
        {others.map((locale) => (
          <li>
            <a href={pageHref(page, locale)} lang={locale.code} hreflang={locale.code}>
              <span class="chip small" aria-hidden="true">{locale.short}</span>
              {locale.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .switcher {
    position: relative;
  }

  /* The sticker is 36px; the padding keeps the tap target at 44px. */
  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 4px;
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 6px;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.875rem;
    line-height: 1;
    letter-spacing: 0.02em;
    rotate: var(--tilt-left-slight);
  }

  .switcher[open] summary .chip {
    box-shadow: none;
    translate: var(--press-offset) var(--press-offset);
  }

  .chip.small {
    min-width: 30px;
    height: 30px;
    box-shadow: none;
    font-size: 0.8125rem;
    rotate: 0deg;
  }

  .menu {
    position: absolute;
    top: calc(100% + var(--space-xs));
    right: 0;
    z-index: 5;
    min-width: 13.5rem;
    margin: 0;
    padding: var(--space-sm);
    list-style: none;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .menu a {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 44px;
    padding: 0 var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu a:hover {
    background: var(--color-surface-muted);
  }
</style>
