---
import type { FeatureId } from '../i18n/dictionary';

interface Props {
  id: FeatureId;
  title: string;
  body?: string | undefined;
}

const { id, title, body } = Astro.props;

const look: Record<FeatureId, { tint: string; tilt: string }> = {
  split: { tint: 'sage', tilt: 'left' },
  settle: { tint: 'sky', tilt: 'left-slight' },
  nudge: { tint: 'lilac', tilt: 'right-slight' },
};

const { tint, tilt } = look[id];
---

<li class="card">
  <div class="tile" style={`background: var(--color-tint-${tint}); rotate: var(--tilt-${tilt})`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
      {id === 'split' && <><circle cx="12" cy="12" r="9" /><path d="M12 3v9h9M12 12l-6 6.5" /></>}
      {id === 'settle' && <path d="M4 12.5 9 17.5 20 6.5" />}
      {id === 'nudge' && <path d="M4 5h16v11H9.5L4 20.5z" />}
    </svg>
  </div>
  <div class:list={['text', { centered: !body }]}>
    <h3>{title}</h3>
    {body && <p>{body}</p>}
  </div>
</li>

<style>
  .card {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .tile {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  svg {
    fill: none;
    stroke: var(--color-outline);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .centered {
    align-self: center;
  }

  p {
    font-size: 0.9375rem;
    line-height: 1.45;
  }
</style>
