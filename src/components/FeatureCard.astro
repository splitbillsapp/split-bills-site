---
import type { FeatureId } from '../i18n/dictionary';

interface Props {
  id: FeatureId;
  title: string;
  body?: string | undefined;
}

const { id, title, body } = Astro.props;

const look: Record<FeatureId, { tint: string; tilt: string }> = {
  split: { tint: 'sage', tilt: 'left' },
  trace: { tint: 'apricot', tilt: 'right' },
  settle: { tint: 'sky', tilt: 'left-slight' },
  nudge: { tint: 'lilac', tilt: 'right-slight' },
  calendar: { tint: 'butter', tilt: 'left' },
  currency: { tint: 'periwinkle', tilt: 'right' },
};

const { tint, tilt } = look[id];
---

<li class="card">
  <div class="tile" style={`background: var(--color-tint-${tint}); rotate: var(--tilt-${tilt})`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
      {id === 'split' && <><circle cx="12" cy="12" r="9" /><path d="M12 3v9h9M12 12l-6 6.5" /></>}
      {
        id === 'trace' && (
          <>
            <path d="M4 6h16M4 12h9M4 18h6" />
            <circle cx="17" cy="17" r="3.5" />
            <path d="M19.6 19.6 22 22" />
          </>
        )
      }
      {id === 'settle' && <path d="M4 12.5 9 17.5 20 6.5" />}
      {id === 'nudge' && <path d="M4 5h16v11H9.5L4 20.5z" />}
      {
        id === 'calendar' && (
          <>
            <rect x="3" y="5" width="18" height="16" rx="3" />
            <path d="M3 10h18M8 3v4M16 3v4" />
          </>
        )
      }
      {
        id === 'currency' && (
          <>
            <circle cx="9" cy="10" r="6.5" />
            <path d="M14.2 6.2a6.5 6.5 0 1 1-3.4 11.6" />
          </>
        )
      }
    </svg>
  </div>
  <div class:list={['text', { centered: !body }]}>
    <h3>{title}</h3>
    {body && <p>{body}</p>}
  </div>
</li>

<style>
  .card {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }

  .tile {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  svg {
    fill: none;
    stroke: var(--color-outline);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .centered {
    align-self: center;
  }

  p {
    font-size: 0.9375rem;
    line-height: 1.45;
  }
</style>
