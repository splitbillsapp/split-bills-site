---
import calendar from '../assets/screens/calendar.png';
import entry from '../assets/screens/entry.png';
import homeZh from '../assets/screens/home-zh.png';
import person from '../assets/screens/person.png';
import settle from '../assets/screens/settle.png';
import split from '../assets/screens/split.png';
import FeatureCard from './FeatureCard.astro';
import Mark from './Mark.astro';
import PhoneFrame from './PhoneFrame.astro';
import RecordSticker from './RecordSticker.astro';
import StoreBadge from './StoreBadge.astro';
import Site from '../layouts/Site.astro';
import { dictionary, pageHref } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale.code);
const stripSizes = '(min-width: 60em) 240px, 30vw';
---

<Site title={`${t.site.name}: ${t.site.tagline}`} description={t.site.description} page="home">
  <section class="container hero">
    <div class="hero-copy">
      <h1>{t.site.tagline}</h1>
      <p class="lede">{t.home.lede}</p>
      <StoreBadge locale={locale.code} />
    </div>
    <figure class="hero-visual" aria-label={t.home.hero.label}>
      <PhoneFrame
        class="hero-phone"
        screen={person}
        alt={t.home.hero.screenAlt}
        widths={[236, 300]}
        sizes="(min-width: 60em) 300px, 62vw"
        tilt="left-slight"
        loading="eager"
      />
      <ul class="records">
        {
          t.home.hero.records.map((record, index) => (
            <RecordSticker class={`record-${index + 1}`} {...record} />
          ))
        }
      </ul>
    </figure>
  </section>

  <section class="container ways">
    <div class="ways-copy">
      <h2>{t.home.ways.heading}</h2>
      <p>{t.home.ways.body}</p>
    </div>
    <PhoneFrame
      class="ways-phone"
      screen={entry}
      alt={t.home.ways.screenAlt}
      widths={[220, 280]}
      sizes="(min-width: 60em) 280px, 220px"
      tilt="right-slight"
      shadow="xl"
    />
  </section>

  <section class="container features">
    <h2>{t.home.features.heading}</h2>
    <ul class="feature-list">
      {t.home.features.items.map((item) => <FeatureCard {...item} />)}
    </ul>
  </section>

  <section class="container strip" aria-label={t.home.screens.label}>
    <PhoneFrame
      screen={split}
      alt={t.home.screens.alts.split}
      widths={[110, 160, 240]}
      sizes={stripSizes}
      tilt="left-slight"
      shadow="md"
      radius="lg"
    />
    <PhoneFrame
      class="strip-middle"
      screen={settle}
      alt={t.home.screens.alts.settle}
      widths={[110, 160, 240]}
      sizes={stripSizes}
      shadow="md"
      radius="lg"
    />
    <PhoneFrame
      screen={calendar}
      alt={t.home.screens.alts.calendar}
      widths={[110, 160, 240]}
      sizes={stripSizes}
      tilt="right-slight"
      shadow="md"
      radius="lg"
    />
  </section>

  <section class="container">
    <div class="privacy">
      <h2>{t.home.privacy.heading}</h2>
      <p>{t.home.privacy.body}</p>
      <a href={pageHref('privacy', locale)}>{t.home.privacy.link}</a>
    </div>
  </section>

  <section class="container languages">
    <div class="languages-copy">
      <h2>{t.home.languages.heading}</h2>
      <ul class="language-list">
        {
          t.home.languages.items.map((item, index) => (
            <li class:list={['display', 'language', `language-${index + 1}`]} lang={item.lang}>
              {item.label}
            </li>
          ))
        }
      </ul>
    </div>
    <PhoneFrame
      class="languages-phone"
      screen={homeZh}
      alt={t.home.screens.alts.homeZh}
      widths={[200, 260]}
      sizes="(min-width: 60em) 260px, 200px"
      tilt="left-slight"
      shadow="xl"
    />
  </section>

  <section class="container cta">
    <Mark size={88} />
    <h2>{t.home.cta.heading}</h2>
    <StoreBadge locale={locale.code} size="lg" />
  </section>
</Site>

<style>
  section + section {
    margin-block-start: var(--space-section);
  }

  h2 {
    margin-block-end: var(--space-lg);
  }

  /* Hero */
  .hero {
    display: grid;
    gap: var(--space-xxl);
    padding-block-start: var(--space-xxl);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .lede {
    max-width: 30ch;
    font-size: var(--text-lede);
    text-wrap: pretty;
  }

  /* Every child is absolutely positioned, so the figure needs an explicit width to have any size. */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 358 / 540;
  }

  .hero-visual :global(.hero-phone) {
    position: absolute;
    top: 4%;
    left: 1%;
    width: 62%;
  }

  .records {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .records > :global(li) {
    position: absolute;
    width: 54%;
    --tilt: 0deg;
    rotate: var(--tilt);
    animation: land 480ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }

  .records > :global(.record-1) {
    top: 18%;
    left: 48%;
    --tilt: var(--tilt-right);
    animation-delay: 240ms;
  }

  .records > :global(.record-2) {
    top: 41%;
    left: 44%;
    width: 55%;
    --tilt: var(--tilt-left);
    animation-delay: 380ms;
  }

  .records > :global(.record-3) {
    top: 64%;
    left: 50%;
    --tilt: var(--tilt-right-slight);
    animation-delay: 520ms;
  }

  /* Movement only: an opacity ramp leaves the text below AA contrast while it runs. */
  @keyframes land {
    from {
      translate: 0 -28px;
    }

    to {
      translate: 0 0;
    }
  }

  /* Two ways in */
  .ways {
    display: grid;
    gap: var(--space-xl);
  }

  .ways-copy p {
    max-width: 36ch;
    font-size: var(--text-lede);
  }

  .ways :global(.ways-phone) {
    width: 220px;
    justify-self: center;
    margin-block: var(--space-lg);
  }

  /* Features */
  .feature-list {
    display: grid;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
  }

  /* Screens strip */
  .strip {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    justify-content: center;
  }

  .strip > :global(*) {
    flex: 0 1 240px;
    min-width: 0;
  }

  .strip :global(.strip-middle) {
    margin-block-start: var(--space-lg);
  }

  /* Privacy */
  .privacy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-xl);
    background: var(--color-text);
    color: var(--color-on-ink);
    border-radius: var(--radius-xl);
  }

  .privacy h2 {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem);
  }

  .privacy p {
    max-width: 44ch;
  }

  .privacy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .privacy a:focus-visible {
    outline-color: var(--color-on-ink);
  }

  /* Languages */
  .languages {
    display: grid;
    gap: var(--space-xl);
  }

  .language-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
    padding: var(--space-xs);
    list-style: none;
  }

  .language {
    padding: var(--space-md);
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    font-size: 1.0625rem;
    text-align: center;
  }

  .language-1 {
    rotate: var(--tilt-left-slight);
  }

  .language-2 {
    rotate: var(--tilt-right-slight);
  }

  .language-3 {
    rotate: var(--tilt-right);
  }

  .language-4 {
    rotate: var(--tilt-left);
  }

  .languages :global(.languages-phone) {
    width: 200px;
    justify-self: center;
    margin-block: var(--space-lg);
  }

  /* Closing call to action */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .cta h2 {
    margin: 0;
  }

  @media (min-width: 60em) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xxl);
      padding-block-start: var(--space-section);
    }

    .hero-visual {
      max-width: 34rem;
      justify-self: end;
    }

    .ways,
    .languages {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-section);
    }

    .ways :global(.ways-phone) {
      width: 280px;
      margin-block: 0;
    }

    .languages :global(.languages-phone) {
      width: 260px;
      margin-block: 0;
    }

    .feature-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl);
    }

    .strip {
      gap: var(--space-xxl);
    }

    .privacy {
      padding: var(--space-xxl) calc(var(--space-xxl) + var(--space-sm));
    }

    .language-list {
      grid-template-columns: repeat(2, minmax(0, 14rem));
    }
  }
</style>
