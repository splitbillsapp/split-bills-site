---
import entry from '../assets/screens/entry.png';
import person from '../assets/screens/person.png';
import FeatureCard from './FeatureCard.astro';
import PhoneFrame from './PhoneFrame.astro';
import RecordSticker from './RecordSticker.astro';
import StoreBadge from './StoreBadge.astro';
import Site from '../layouts/Site.astro';
import { dictionary, pageHref } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale.code);
---

<Site title={`${t.site.name}: ${t.site.tagline}`} description={t.site.description} page="home">
  <section class="container hero">
    <div class="hero-copy">
      <h1>{t.site.tagline}</h1>
      <p class="lede">{t.home.lede}</p>
      <p class="reassurance">{t.home.reassurance}</p>
      <StoreBadge locale={locale.code} />
    </div>
    <figure class="hero-visual" aria-label={t.home.hero.label}>
      <PhoneFrame
        class="hero-phone"
        screen={person}
        alt={t.home.hero.screenAlt}
        widths={[236, 300]}
        sizes="(min-width: 60em) 300px, 62vw"
        tilt="left-slight"
        loading="eager"
      />
      <ul class="records">
        {
          t.home.hero.records.map((record, index) => (
            <RecordSticker class={`record-${index + 1}`} {...record} />
          ))
        }
      </ul>
    </figure>
  </section>

  <section class="container features">
    <h2>{t.home.features.heading}</h2>
    <div class="benefits">
      <ul class="feature-list">
        {t.home.features.items.map((item) => <FeatureCard {...item} />)}
      </ul>
      <PhoneFrame
        class="entry-phone"
        screen={entry}
        alt={t.home.features.screenAlt}
        widths={[260, 320, 640]}
        sizes="(min-width: 60em) 320px, 260px"
        tilt="right-slight"
        shadow="xl"
      />
    </div>
  </section>

  <section class="container">
    <div class="privacy">
      <h2>{t.home.privacy.heading}</h2>
      <p>{t.home.privacy.body}</p>
      <a href={pageHref('privacy', locale)}>{t.home.privacy.link}</a>
    </div>
  </section>


  <section class="container cta">
    <h2>{t.home.cta.heading}</h2>
    <StoreBadge locale={locale.code} size="lg" />
  </section>
</Site>

<style>
  section + section {
    margin-block-start: var(--space-section);
  }

  h2 {
    margin-block-end: var(--space-lg);
  }

  /* Hero */
  .hero {
    display: grid;
    gap: var(--space-xxl);
    padding-block-start: var(--space-xxl);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .lede {
    max-width: 30ch;
    font-size: var(--text-lede);
    text-wrap: pretty;
  }

  /* Every child is absolutely positioned, so the figure needs an explicit width to have any size. */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 30rem;
    aspect-ratio: 358 / 540;
  }

  .hero-visual :global(.hero-phone) {
    position: absolute;
    top: 4%;
    left: 1%;
    width: 62%;
  }

  .records {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .records > :global(li) {
    position: absolute;
    width: 54%;
    --tilt: 0deg;
    rotate: var(--tilt);
    animation: land 480ms cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }

  .records > :global(.record-1) {
    top: 18%;
    left: 48%;
    --tilt: var(--tilt-right);
    animation-delay: 240ms;
  }

  .records > :global(.record-2) {
    top: 41%;
    left: 44%;
    width: 55%;
    --tilt: var(--tilt-left);
    animation-delay: 380ms;
  }

  .records > :global(.record-3) {
    top: 64%;
    left: 50%;
    --tilt: var(--tilt-right-slight);
    animation-delay: 520ms;
  }

  /* Movement only: an opacity ramp leaves the text below AA contrast while it runs. */
  @keyframes land {
    from {
      translate: 0 -28px;
    }

    to {
      translate: 0 0;
    }
  }

  .reassurance {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .features h2 {
    max-width: 24ch;
  }

  .benefits {
    display: grid;
    gap: var(--space-xxl);
    align-items: start;
  }

  .feature-list {
    display: grid;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .benefits :global(.entry-phone) {
    width: 260px;
    max-width: 100%;
    justify-self: center;
  }

  /* Privacy */
  .privacy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-xl);
    background: var(--color-text);
    color: var(--color-on-ink);
    border-radius: var(--radius-xl);
  }

  .privacy h2 {
    margin: 0;
    font-size: clamp(1.625rem, 1.25rem + 1.5vw, 2.25rem);
  }

  .privacy p {
    max-width: 44ch;
  }

  .privacy a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .privacy a:focus-visible {
    outline-color: var(--color-on-ink);
  }

  /* Closing call to action */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    text-align: center;
  }

  .cta h2 {
    margin: 0;
  }

  @media (min-width: 60em) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-xxl);
      padding-block-start: var(--space-section);
    }

    .hero-visual {
      max-width: 34rem;
      justify-self: end;
    }

    .benefits {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-xxl);
    }

    .benefits :global(.entry-phone) {
      width: 320px;
    }

    .privacy {
      padding: var(--space-xxl) calc(var(--space-xxl) + var(--space-sm));
    }
  }
</style>
