---
import { dictionary, fill, localesFor, pageHref, type PageId } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = dictionary(locale.code);
const languages = localesFor('home');
---

<footer class="footer">
  <div class="container inner">
    <ul class="links">
      <li><a href={pageHref('privacy', locale)}>{t.footer.privacy}</a></li>
      <li><a href={pageHref('deleteAccount', locale)}>{t.footer.deleteAccount}</a></li>
      <li><a href={`mailto:${t.site.supportEmail}`}>{t.site.supportEmail}</a></li>
    </ul>
    {
      languages.length > 1 && (
        <nav class="languages" aria-label={t.nav.language}>
          <ul class="language-list">
            {languages.map((candidate) => (
              <li>
                <a
                  class:list={['language', { current: candidate.code === locale.code }]}
                  href={pageHref(page, candidate)}
                  lang={candidate.code}
                  hreflang={candidate.code}
                  aria-current={candidate.code === locale.code ? 'page' : undefined}
                >
                  <span class="chip" aria-hidden="true">{candidate.short}</span>
                  {candidate.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="made">{fill(t.footer.madeBy, { developer: t.site.developer })}</p>
  </div>
</footer>

<style>
  .footer {
    margin-block-start: var(--space-section);
    background: var(--color-surface);
    border-top: var(--keyline-thick) solid var(--color-outline);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-xl) var(--space-xxl);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-xl);
    row-gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .language-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-xl);
    row-gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .language {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    font-weight: 500;
    text-decoration: none;
  }

  .language:hover {
    text-decoration: underline;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 5px;
    background: var(--color-surface);
    border: var(--keyline-base) solid var(--color-outline);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .current {
    font-weight: 700;
  }

  .current .chip {
    background: var(--color-text);
    color: var(--color-on-ink);
  }

  .made {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
    font-weight: 500;
  }
</style>
